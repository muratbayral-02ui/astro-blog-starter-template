// muratbayral.com — Personal site
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Murat Bayral — Designer, Teacher, Creator</title>
    <meta name="description" content="Designer by Trade. Teacher by Choice. Creator by Accident. London based. Figma obsessed. Teaching design that actually works at 02UI." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      @font-face {
        font-family: 'Young Serif Light';
        src: url('/youngserif.light.otf') format('opentype');
        font-weight: 300;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --bg: #F0F0F0;
        --grey: #898989;
        --orange: #FF4802;
        --font: 'JetBrains Mono', monospace;
      }

      html, body {
        height: 100%;
      }

      body {
        background-color: var(--bg);
        color: var(--grey);
        font-family: var(--font);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      /* NAV */
      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem 2.5rem;
      }

      nav a.blog-link {
        font-size: 0.75rem;
        font-weight: 400;
        color: var(--grey);
        text-decoration: none;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      nav a.blog-link:hover {
        color: var(--orange);
      }

      /* MAIN */
      main {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 1.5rem 2.5rem 2rem;
      }

      .photo {
        width: 72px;
        height: 72px;
        border-radius: 12px;
        object-fit: cover;
        object-position: center top;
        margin-bottom: 2.5rem;
        filter: grayscale(100%);
      }

      .hero-title {
        font-family: 'Young Serif Light', serif;
        font-size: 100px;
        font-weight: 400;
        line-height: 0.8;
        color: var(--grey);
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
      }

      .hero-title .highlight {
        color: var(--orange);
        text-decoration: underline;
        text-decoration-thickness: 3px;
        text-underline-offset: 6px;
      }

      .hero-tagline {
        font-family: 'JetBrains Mono', monospace;
        font-size: 20px;
        font-weight: 300;
        color: var(--grey);
        letter-spacing: 0.02em;
        line-height: 1.2;
      }

      /* FOOTER */
      footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem 2.5rem;
      }

      .footer-logos {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      .footer-logos a {
        display: flex;
        align-items: center;
        opacity: 0.85;
        transition: opacity 0.2s ease;
      }

      .footer-logos a:hover {
        opacity: 1;
      }

      .social-links {
        display: flex;
        gap: 1.1rem;
        align-items: center;
      }

      .social-links a {
        color: var(--grey);
        text-decoration: none;
        opacity: 0.8;
        transition: opacity 0.2s ease, color 0.2s ease;
        display: flex;
        align-items: center;
      }

      .social-links a:hover {
        opacity: 1;
        color: var(--orange);
      }

      .social-links svg {
        width: 18px;
        height: 18px;
        fill: currentColor;
        display: block;
      }

      /* Animations */
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(14px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      nav           { animation: fadeUp 0.5s ease both 0.0s; }
      .photo        { animation: fadeUp 0.5s ease both 0.1s; }
      .hero-title   { animation: fadeUp 0.5s ease both 0.15s; }
      .hero-tagline { animation: fadeUp 0.5s ease both 0.22s; }
      footer        { animation: fadeUp 0.5s ease both 0.28s; }
    </style>
  </head>
