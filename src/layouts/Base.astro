---
const { title = 'My Blog', description = 'Notes and updates', pageTitle } = Astro.props;
const currentPath = Astro.url.pathname;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <title>{pageTitle ? pageTitle + ' · ' + title : title}</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <header>
      <div class="container">
        <a href="/"><strong>{title}</strong></a>
        <nav style="margin-top:8px">
          <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>
          <a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined}>About</a>
          <a href="/posts" aria-current={currentPath.startsWith('/posts') ? 'page' : undefined}>Posts</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer>
      <div class="container">
        <hr />
        <div class="meta">© {new Date().getFullYear()} Your Name</div>
      </div>
    </footer>
  </body>
</html>
